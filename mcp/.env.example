# Configuration contract only. No credentials or OAuth grants are provisioned here.
FACTORY_APP_ORIGIN=https://factory.example
FACTORY_MCP_RESOURCE=https://factory.example/api/mcp
FACTORY_MCP_ISSUER=https://project.example/auth/v1
FACTORY_MCP_CLIENT_IDS=
# Enable only after the approved native Auth and MCP isolation/read gates pass.
FACTORY_MCP_WRITES_ENABLED=false
FACTORY_MCP_DATABASE_HOST=
FACTORY_MCP_DATABASE_USER=factory_mcp_gateway
FACTORY_MCP_DATABASE_URL=
# Optional override; omitted uses the bundled public Supabase Root 2021 CA.
# Paths are local to the server, never the owner's Windows certificate path.
# FACTORY_MCP_DATABASE_CA_FILE=mcp/certs/supabase-root-2021.crt
